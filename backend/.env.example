# Safe checklist only. Spring Boot does not load this file automatically.
# Supply values through a protected process environment or service manager.
DB_URL=jdbc:postgresql://127.0.0.1:5432/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

JWT_SECRET=
JWT_ISSUER=your_application_issuer
JWT_ACCESS_TOKEN_EXPIRATION=15m

APP_TIMEZONE=Africa/Cairo
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false

LOGIN_MAXIMUM_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

BACKUP_ENABLED=false
BACKUP_DIRECTORY=C:/BeautyCenterData/backups
BACKUP_RETENTION_COUNT=30
PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
BACKUP_TIMEOUT=10m
BACKUP_FILENAME_PREFIX=beauty-center
