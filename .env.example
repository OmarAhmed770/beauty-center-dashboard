# Safe configuration checklist. Copy only the values you need to a private,
# ignored environment file or protected process environment. Never commit secrets.
# Spring Boot does not load this file automatically.

# Spring Boot database connection. Use the same names for Docker, a locally
# installed PostgreSQL server, or a hosted PostgreSQL server.
DB_URL=jdbc:postgresql://localhost:5432/your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=

# Spring Boot security and server settings.
JWT_SECRET=
JWT_ISSUER=your_application_issuer
JWT_ACCESS_TOKEN_EXPIRATION=15m
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_TIMEZONE=Africa/Cairo

# Offline login protection. The first OWNER is created through the one-time setup screen.
LOGIN_MAXIMUM_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m

# Vite API target. Leave blank behind a same-origin reverse proxy.
VITE_API_BASE_URL=http://localhost:8080

# Docker Compose only. These create the PostgreSQL container database and role.
# When using Docker, keep these values aligned with DB_URL, DB_USERNAME, and DB_PASSWORD.
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
