# Local acceptance environment only. Copy this file to .env.acceptance.local,
# fill the placeholders privately, and never commit the populated copy.
# This file is not loaded automatically by Spring Boot or Vite.

# Isolated PostgreSQL database used only by the acceptance profile.
ACCEPTANCE_DB_URL=jdbc:postgresql://127.0.0.1:5434/beauty_center_acceptance
ACCEPTANCE_DB_USERNAME=acceptance_application_role
ACCEPTANCE_DB_PASSWORD=

# Acceptance-only application security and local addresses.
ACCEPTANCE_JWT_SECRET=
ACCEPTANCE_JWT_ISSUER=beauty-center-acceptance
ACCEPTANCE_JWT_ACCESS_TOKEN_EXPIRATION=15m
ACCEPTANCE_SERVER_ADDRESS=127.0.0.1
ACCEPTANCE_SERVER_PORT=8081
ACCEPTANCE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ACCEPTANCE_VITE_API_BASE_URL=http://127.0.0.1:8081

# Required guard for the acceptance-only user seeder.
ACCEPTANCE_SEED_ENABLED=true
ACCEPTANCE_OWNER_USERNAME=acceptance.owner
ACCEPTANCE_OWNER_PASSWORD=
ACCEPTANCE_MANAGER_USERNAME=acceptance.manager
ACCEPTANCE_MANAGER_PASSWORD=
ACCEPTANCE_RECEPTIONIST_USERNAME=acceptance.receptionist
ACCEPTANCE_RECEPTIONIST_PASSWORD=

# Optional Docker PostgreSQL variables. Use these only with
# .\run-acceptance.ps1 -UseDockerPostgres. Keep this database/role separate
# from every development and production database/role.
POSTGRES_DB=beauty_center_acceptance
POSTGRES_USER=acceptance_application_role
POSTGRES_PASSWORD=
POSTGRES_PORT=5434
